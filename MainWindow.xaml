<Window x:Class="WPF_HW15.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_HW15"
        mc:Ignorable="d"
        Title="Римская когорта" Height="700" Width="900" Background="#2B1B17">

    <DockPanel>


        <Border DockPanel.Dock="Top" Background="#5A1A14" Padding="10,6">
            <DockPanel>
                <Button x:Name="ClearButton"
                        DockPanel.Dock="Right"
                        Content="Очистить"
                        Padding="18,4"
                        Margin="10"
                        Foreground="#2B1B17"
                        Background="#D8B65A"
                        BorderBrush="#8A6D1F"
                        FontWeight="Bold"
                        Click="ClearButton_Click"/>
                <Button x:Name="SaveButton"
                        DockPanel.Dock="Right"
                        Content="Сохранить"
                        Padding="18,4"
                        Margin="10"
                        Foreground="#2B1B17"
                        Background="#D8B65A"
                        BorderBrush="#8A6D1F"
                        FontWeight="Bold"
                        Click="SaveButton_Click"/>
                <Button x:Name="OpenButton"
                        DockPanel.Dock="Right"
                        Content="Открыть"
                        Padding="18,4"
                        Margin="10"
                        Foreground="#2B1B17"
                        Background="#D8B65A"
                        BorderBrush="#8A6D1F"
                        FontWeight="Bold"
                        Click="OpenButton_Click"/>
                <TextBlock Text="Duis congue numerus XV"
                           Foreground="#F1E3BC"
                           FontFamily="Palatino Linotype"
                           FontSize="20"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <FlowDocumentScrollViewer x:Name="docViewer" Background="#E9DCB8">
            <FlowDocument x:Name="Doc"
                          FontFamily="Palatino Linotype"
                          FontSize="16"
                          Background="#F6EDD2"
                          PagePadding="60,40,60,50"
                          ColumnWidth="9999"
                          TextAlignment="Justify"
                          IsOptimalParagraphEnabled="True"
                          IsHyphenationEnabled="True">



                <Paragraph TextAlignment="Center" Margin="0,4,0,0"
                           FontSize="44" FontWeight="Bold" Foreground="#7A1F16">
                    <Run Text="РИМСКАЯ КОГОРТА"/>
                </Paragraph>



                <Paragraph TextIndent="24" Margin="0,8,0,8">
                    <Hyperlink NavigateUri="https://ru.wikipedia.org/wiki/%D0%9A%D0%BE%D0%B3%D0%BE%D1%80%D1%82%D0%B0"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="#7A1F16">Когорта</Hyperlink>
                    <Run Text=" (лат."/>
                    <Italic>
                        <Run Text=" cohors"/>
                    </Italic>
                    <Run Text=", буквально «толпа») — тактическое подразделение римской армии. Сначала так называли отряд, который выставлял для союзного войска каждый народ Италии, а позднее когорта стала основной боевой частью легиона: именно из десяти когорт состоял легион в эпоху Империи."/>
                </Paragraph>

 
                <Paragraph>
                    <Figure HorizontalAnchor="PageRight"
                            Width="100"
                            Padding="0"
                            Margin="14,0,0,6">
                        <BlockUIContainer>
                            <Image Source="Data/rom_legionaries.png" Stretch="Uniform"/>
                        </BlockUIContainer>
                    </Figure>
                    <Run Text=" "/>
                </Paragraph>


                <Paragraph FontSize="26" FontWeight="Bold" Foreground="#7A1F16" Margin="0,18,0,4"
                           BorderBrush="#B8962E" BorderThickness="0,0,0,1">
                    <Run Text="История появления"/>
                </Paragraph>

                <Paragraph TextIndent="24">
                    <Run Text="Деление легиона на когорты складывалось постепенно. Основные этапы, которые называют справочники, выстроены ниже в хронологическом порядке."/>
                </Paragraph>


                <List MarkerStyle="Decimal" Margin="0,4,0,8" Padding="30,0,0,0">
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Италийские союзники."/>
                            </Bold>
                            <Run Text=" Каждый народ Италии выставлял для римлян отряд, который оставался национальным целым под своим знаменем и командой своих и римских офицеров."/>
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Реформа манипулярного легиона."/>
                            </Bold>
                            <Run Text=" С IV в. до н. э. (реформа приписывается Камиллу) легион делился на манипулы, а каждый манипул — на две центурии."/>
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Вторая Пуническая война (218–201 гг. до н. э.)."/>
                            </Bold>
                            <Run Text=" Тридцать манипулов сводятся в десять когорт; в ходе войны размеры когорт менялись в зависимости от нужд консульского войска."/>
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Реформа Мария."/>
                            </Bold>
                            <Run Text=" Исчезает различие в вооружении, и деление на манипулы теряет смысл: легион закрепляется как десять когорт по 400–500 человек."/>
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Эпоха Империи."/>
                            </Bold>
                            <Run Text=" Первая когорта удваивается, а вне легионов появляются самостоятельные когорты: городские, преторианские, вспомогательные."/>
                        </Paragraph>
                    </ListItem>
                </List>


                <Paragraph FontSize="26" FontWeight="Bold" Foreground="#7A1F16" Margin="0,18,0,4"
                           BorderBrush="#B8962E" BorderThickness="0,0,0,1">
                    <Run Text="Устройство легиона"/>
                </Paragraph>

                <Paragraph TextIndent="24">
                    <Run Text="В эпоху принципата легион состоял из десяти когорт. Когорта делилась на три манипула, манипул — на две центурии, а центурией командовал "/>
                    <Bold>
                        <Run Text="центурион"/>
                    </Bold>
                    <Run Text=". Таблица показывает, как выглядела эта иерархия."/>
                </Paragraph>

                
                <Table CellSpacing="0" BorderBrush="#7A1F16" BorderThickness="1.5" Margin="0,8,0,12">
                    <Table.Columns>
                        <TableColumn Width="1.1*"/>
                        <TableColumn Width="2.4*"/>
                        <TableColumn Width="1.6*"/>
                    </Table.Columns>

                    <TableRowGroup>

                        <TableRow Background="#7A1F16" Foreground="#F6EDD2" FontWeight="Bold">
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Подразделение"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Состав и численность"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Командир"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#F6EDD2">
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Bold>
                                        <Run Text="Легион"/>
                                    </Bold>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="10 когорт; до 6000 человек, из них около 4800 — тяжёлая пехота"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Легат (в республике — трибун)"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#EBDDB6">
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Bold>
                                        <Run Text="Когорта"/>
                                    </Bold>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="3 манипула, или 6 центурий; около 480 человек (первая когорта — удвоенная)"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Центурион высшего ранга"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#F6EDD2">
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Bold>
                                        <Run Text="Манипул"/>
                                    </Bold>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="2 центурии"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Центурион первой центурии"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#EBDDB6">
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Bold>
                                        <Run Text="Центурия"/>
                                    </Bold>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="около 80 человек"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Центурион"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>
                    </TableRowGroup>
                </Table>


                <Paragraph FontSize="26" FontWeight="Bold" Foreground="#7A1F16" Margin="0,18,0,4"
                           BorderBrush="#B8962E" BorderThickness="0,0,0,1">
                    <Run Text="Когорты вне легиона"/>
                </Paragraph>

                <Paragraph TextIndent="24">
                    <Run Text="К концу республики и при императорах стали обычными особые когорты, не входившие в состав легиона. Они могли состоять из 500 человек ("/>
                    <Italic>
                        <Run Text="cohortes quingenariae"/>
                    </Italic>
                    <Run Text=") или из 1000 ("/>
                    <Italic>
                        <Run Text="cohortes miliariae"/>
                    </Italic>
                    <Run Text=")."/>
                </Paragraph>


                <List MarkerStyle="Disc" Margin="0,4,0,8" Padding="30,0,0,0">
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Вспомогательные (ауксилии)"/>
                            </Bold>
                            <Run Text=" — набирались в провинциях."/>
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Когорты римских граждан"/>
                            </Bold>
                            <Run Text=" — формировались в Италии, служили в них преимущественно граждане."/>
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Городские когорты"/>
                            </Bold>
                            <Run Text=" — по 1000 человек под командой префекта города."/>
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Когорты вигилов"/>
                            </Bold>
                            <Run Text=" — пожарные 14 округов Рима."/>
                        </Paragraph>
                    </ListItem>
                    <ListItem>
                        <Paragraph>
                            <Bold>
                                <Run Text="Преторианские когорты"/>
                            </Bold>
                            <Run Text=" — телохранители императора."/>
                        </Paragraph>
                    </ListItem>
                </List>


                <Paragraph FontSize="26" FontWeight="Bold" Foreground="#7A1F16" Margin="0,18,0,4"
                           BorderBrush="#B8962E" BorderThickness="0,0,0,1">
                    <Run Text="Воины когорты"/>
                </Paragraph>

                <Paragraph TextIndent="24">
                    <Run Text="В строю и рядом с ним служили люди разных званий и специальностей. Ниже — несколько характерных фигур."/>
                </Paragraph>

                <Table CellSpacing="10" Margin="0,8,0,8">
                    <Table.Columns>
                        <TableColumn Width="*"/>
                        <TableColumn Width="*"/>
                        <TableColumn Width="*"/>
                        <TableColumn Width="*"/>
                        <TableColumn Width="*"/>
                        <TableColumn Width="*"/>
                        <TableColumn Width="*"/>
                    </Table.Columns>
                    <TableRowGroup>
                        <TableRow>
                            <TableCell>
                                <BlockUIContainer>
                                    <Image Source="Data/rom_hastati.png" Stretch="Uniform"/>
                                </BlockUIContainer>
                                <Paragraph TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#7A1F16" Margin="0,2,0,0">
                                    <Run Text="Гастаты"/>
                                </Paragraph>
                                <Paragraph TextAlignment="Center" FontSize="12" FontStyle="Italic" Foreground="#6B5A3A" Margin="0">
                                    <Run Text="первая линия манипулы"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell>
                                <BlockUIContainer>
                                    <Image Source="Data/rom_principes.png" Stretch="Uniform"/>
                                </BlockUIContainer>
                                <Paragraph TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#7A1F16" Margin="0,2,0,0">
                                    <Run Text="Принципы"/>
                                </Paragraph>
                                <Paragraph TextAlignment="Center" FontSize="12" FontStyle="Italic" Foreground="#6B5A3A" Margin="0">
                                    <Run Text="вторая линия манипулы"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell>
                                <BlockUIContainer>
                                    <Image Source="Data/rom_triarii.png" Stretch="Uniform"/>
                                </BlockUIContainer>
                                <Paragraph TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#7A1F16" Margin="0,2,0,0">
                                    <Run Text="Триарии"/>
                                </Paragraph>
                                <Paragraph TextAlignment="Center" FontSize="12" FontStyle="Italic" Foreground="#6B5A3A" Margin="0">
                                    <Run Text="третья линия манипулы"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell>
                                <BlockUIContainer>
                                    <Image Source="Data/rom_legionary_cav.png" Stretch="Uniform"/>
                                </BlockUIContainer>
                                <Paragraph TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#7A1F16" Margin="0,2,0,0">
                                    <Run Text="Конница легионариев"/>
                                </Paragraph>
                                <Paragraph TextAlignment="Center" FontSize="12" FontStyle="Italic" Foreground="#6B5A3A" Margin="0">
                                    <Run Text="тяжёлая конница"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell>
                                <BlockUIContainer>
                                    <Image Source="Data/rom_vigiles.png" Stretch="Uniform"/>
                                </BlockUIContainer>
                                <Paragraph TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#7A1F16" Margin="0,2,0,0">
                                    <Run Text="Вигилы"/>
                                </Paragraph>
                                <Paragraph TextAlignment="Center" FontSize="12" FontStyle="Italic" Foreground="#6B5A3A" Margin="0">
                                    <Run Text="городские пожарные и стражники"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell>
                                <BlockUIContainer>
                                    <Image Source="Data/rom_velites.png" Stretch="Uniform"/>
                                </BlockUIContainer>
                                <Paragraph TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#7A1F16" Margin="0,2,0,0">
                                    <Run Text="Велиты"/>
                                </Paragraph>
                                <Paragraph TextAlignment="Center" FontSize="12" FontStyle="Italic" Foreground="#6B5A3A" Margin="0">
                                    <Run Text="легкие застрельшики"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell>
                                <BlockUIContainer>
                                    <Image Source="Data/rom_praetorian_guard.png" Stretch="Uniform"/>
                                </BlockUIContainer>
                                <Paragraph TextAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#7A1F16" Margin="0,2,0,0">
                                    <Run Text="Преторианец"/>
                                </Paragraph>
                                <Paragraph TextAlignment="Center" FontSize="12" FontStyle="Italic" Foreground="#6B5A3A" Margin="0">
                                    <Run Text="телохранители императора"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>
                    </TableRowGroup>
                </Table>


                <Paragraph FontSize="26" FontWeight="Bold" Foreground="#7A1F16" Margin="0,18,0,4"
                           BorderBrush="#B8962E" BorderThickness="0,0,0,1">
                    <Run Text="Словарик терминов"/>
                </Paragraph>


                <Table CellSpacing="0" BorderBrush="#7A1F16" BorderThickness="1.5" Margin="0,6,0,12">
                    <Table.Columns>
                        <TableColumn Width="1.3*"/>
                        <TableColumn Width="3*"/>
                    </Table.Columns>

                    <TableRowGroup>
                        <TableRow Background="#7A1F16" Foreground="#F6EDD2" FontWeight="Bold">
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Термин"/>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="Значение"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#F6EDD2">
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Italic>
                                        <Run Text="cohors"/>
                                    </Italic>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="когорта, буквально «толпа»"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#EBDDB6">
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Italic>
                                        <Run Text="manipulus"/>
                                    </Italic>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="манипул, подразделение из двух центурий"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#F6EDD2">
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Italic>
                                        <Run Text="centuria"/>
                                    </Italic>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="центурия, низшее тактическое подразделение легиона"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#EBDDB6">
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Italic>
                                        <Run Text="centurio"/>
                                    </Italic>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5" BorderBrush="#C9B27A" BorderThickness="0,0,0,1">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="центурион, командир центурии, самый опытный воин"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="#F6EDD2">
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Italic>
                                        <Run Text="legatus"/>
                                    </Italic>
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="8,5">
                                <Paragraph TextAlignment="Left">
                                    <Run Text="легат, командир легиона в императорскую эпоху"/>
                                </Paragraph>
                            </TableCell>
                        </TableRow>
                    </TableRowGroup>
                </Table>

            </FlowDocument>
        </FlowDocumentScrollViewer>
    </DockPanel>
</Window>
